# Copy to .env.local and fill in real values. Never commit real values.

# Jobber "Request a Service" / assessment form embed.
# Get this from Jobber > Client Hub > Request a Service settings, or from
# Jobber's public embeddable form URL for this account. See JOBBER_SETUP.md.
NEXT_PUBLIC_JOBBER_REQUEST_FORM_URL=
NEXT_PUBLIC_JOBBER_EMBED_URL=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Direct link to Redemption's Google Business Profile review page
# (e.g. https://g.page/r/XXXXXXXXXXXX/review).
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# Direct link to Redemption's Google Business Profile listing.
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=

# Canonical production site URL, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://redemptioncleanoutservices.com
